<mxfile host="app.diagrams.net" agent="claude-code"><diagram id="modules" name="Modules"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Hippomem: module map&lt;/b&gt; (src/hippomem). Arrows mean 'calls'. Only the main calls are drawn; every module reads and writes through db.py." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1340" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Clients (engineer's machine)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f7fbff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1340" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Server surface (one process)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f9fdf8;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1340" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Workflows (what happens when)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fffdf5;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="1340" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Core memory (what is stored, who may change it)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fbf8fc;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="1340" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Infrastructure&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fafafa;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1340" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;hooks.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;Claude Code hooks: session-start, prompt, pre-edit, stop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="170" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;gitinfo.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;git hooks: checkout, commit, merge + installers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="170" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;cli.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;hippomem query / review / accept&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="170" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;server.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;MCP tools, server instructions, JSON API (one bearer token per person)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="210" width="550" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;service.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;operations shared by MCP and API, usage log; calls the workflows and core below&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="210" width="170" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;render.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;text shown to agents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="210" width="170" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;config.py + actors.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;team config, tokens, who is acting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="210" width="170" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;drafts.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;branches and their draft trails&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="350" width="170" height="70" as="geometry"/></mxCell><mxCell 